<group name="netforge_training,windows,">
  <rule id="110100" level="3">
    <decoded_as>netforge_training_process</decoded_as>
    <description>NetForge controlled process telemetry</description>
    <options>no_full_log</options>
  </rule>
  <rule id="110101" level="10">
    <if_sid>110100</if_sid>
    <field name="parent" type="pcre2">(?i)^(winword|wmiprvse|services)\.exe$</field>
    <field name="image" type="pcre2">(?i)^(powershell|cmd|rundll32|regsvr32)\.exe$</field>
    <description>Suspicious parent/child behavior in controlled lab</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>
</group>
